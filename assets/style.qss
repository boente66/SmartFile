/* SmartFile QSS theme - professional light theme */

QMainWindow {
    background: #eef2f6;
}

QWidget#sidebar {
    background: #ffffff;
    color: #172033;
    border-right: 1px solid #dce3ec;
}

QLabel#sidebarTitle {
    color: #172033;
    font-size: 18px;
    font-weight: 700;
    padding-bottom: 4px;
}

QLabel#sidebarSubtitle {
    color: #94a3b8;
    font-size: 12px;
    padding-bottom: 18px;
}

QLabel#sidebarSection {
    color: #94a3b8;
    margin-top: 18px;
    margin-bottom: 8px;
    font-size: 10px;
    letter-spacing: 0.08em;
}

QPushButton#sidebarButton {
    background: transparent;
    border: none;
    color: #334155;
    text-align: left;
    padding: 10px 12px;
    border-radius: 10px;
}

QPushButton#sidebarButton[selected="true"] {
    background: #e8f0ff;
    color: #1769e8;
    font-weight: 650;
}

QPushButton#sidebarButton:hover {
    background: #f1f5f9;
}

QWidget#workspace {
    background: transparent;
}

/* Conversor */
QWidget#convertView,
QScrollArea#convertScrollArea,
QWidget#convertContent,
QScrollArea#convertScrollArea QWidget#qt_scrollarea_viewport {
    background: #f4f7fb;
    border: none;
}

QLabel#convertTitle {
    color: #142033;
    font-size: 27px;
    font-weight: 800;
}

QLabel#convertSubtitle,
QLabel#convertHint {
    color: #64748b;
}

QFrame#convertCard {
    background: #ffffff;
    border: 1px solid #dce3ec;
    border-radius: 12px;
}

QLabel#convertSectionTitle {
    color: #172033;
    font-size: 17px;
    font-weight: 750;
    padding-bottom: 3px;
}

QLabel#convertFieldLabel {
    color: #263448;
    font-size: 13px;
    font-weight: 650;
    padding-top: 3px;
}

QWidget#convertView QLineEdit,
QWidget#convertView QComboBox {
    background: #ffffff;
    color: #172033;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    min-height: 38px;
    padding: 4px 10px;
}

QWidget#convertView QLineEdit:focus,
QWidget#convertView QComboBox:focus {
    border: 2px solid #2563eb;
}

QPushButton#convertPrimary {
    background: #1769e8;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#convertPrimary:hover {
    background: #0f5aca;
}

QPushButton#convertPrimary:disabled {
    background: #a9c5ed;
    color: #edf4ff;
}

QPushButton#convertCancel {
    background: #ffffff;
    color: #b42318;
    border-color: #fecaca;
}

QLabel#convertProgressFile {
    color: #172033;
    font-size: 14px;
    font-weight: 700;
}

QLabel#convertProgressPercent {
    color: #1769e8;
    font-size: 15px;
    font-weight: 800;
    min-width: 42px;
}

QWidget#convertView QProgressBar {
    background: #e8edf4;
    border: none;
    border-radius: 4px;
    max-height: 8px;
}

QWidget#convertView QProgressBar::chunk {
    background: #2878e8;
    border-radius: 4px;
}

QFrame#convertHistoryRow {
    background: #fbfcfe;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QLabel#convertHistorySuccess {
    color: #149447;
    font-size: 18px;
    font-weight: 800;
}

QLabel#convertHistoryText {
    color: #263448;
}

QScrollArea#convertScrollArea QScrollBar:vertical {
    background: #e5eaf1;
    width: 11px;
    margin: 2px;
    border-radius: 5px;
}

QScrollArea#convertScrollArea QScrollBar::handle:vertical {
    background: #8c9bad;
    min-height: 32px;
    border-radius: 4px;
}

QScrollArea#convertScrollArea QScrollBar::add-line:vertical,
QScrollArea#convertScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollArea#documentsScrollArea,
QWidget#documentsScrollContent {
    background: #10171e;
}

QWidget#documentsView {
    background: #10171e;
    color: #e5e7eb;
}

QWidget#documentsView QLabel {
    color: #dbe4ee;
}

/* Diálogos nativos mantêm contraste mesmo quando abertos sobre módulos escuros. */
QWidget#documentsView QMessageBox,
QWidget#documentsView QMessageBox QLabel {
    background: #f8fafc;
    color: #0f1720;
}

QWidget#documentsView QMessageBox QPushButton {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #cbd5e1;
}

QWidget#documentsView QLabel#title {
    color: #ffffff;
}

QFrame#documentWorkspaceHeader,
QFrame#documentActionBar,
QFrame#documentFilterBar,
QFrame#documentBrowserHeader {
    background: #121c25;
    border: 1px solid #263541;
    border-radius: 8px;
}

QWidget#documentHeaderGroup {
    background: transparent;
}

QLabel#documentHeaderCaption,
QLabel#documentFilterCaption {
    color: #93a4b5;
    font-size: 10px;
    font-weight: 650;
}

QLabel#documentBreadcrumb {
    color: #e5edf5;
    font-size: 13px;
    font-weight: 650;
    padding-left: 4px;
}

QWidget#documentsView QLineEdit,
QWidget#documentsView QComboBox {
    background: #17212a;
    color: #e5e7eb;
    border: 1px solid #2d3a45;
    border-radius: 6px;
    min-height: 30px;
    padding: 3px 8px;
}

QWidget#documentsView QLineEdit:focus,
QWidget#documentsView QComboBox:focus {
    border-color: #2f8f61;
}

QWidget#documentsView QPushButton#cloudAccountButton {
    background: #17212a;
    color: #e5e7eb;
    border: 1px solid #2d3a45;
}

QWidget#documentsView QLabel#cloudStatusLabel {
    color: #7dd3fc;
}

QWidget#documentsView QLabel#organizationProfileBadge {
    background: #123524;
    color: #86efac;
    border: 1px solid #1f6a42;
    border-radius: 10px;
    padding: 4px 10px;
    font-weight: 600;
}

QWidget#documentsView QPushButton#documentToolbarButton {
    background: #17212a;
    border: 1px solid #27343f;
    border-radius: 7px;
    padding: 6px;
    color: #e5e7eb;
}

QWidget#documentsView QPushButton#documentToolbarButton[primaryAction="true"] {
    background: #135c37;
    border-color: #1e7b4b;
    color: #ffffff;
}

QWidget#documentsView QPushButton#documentToolbarButton:checked {
    background: #174f37;
    border-color: #2ca66a;
}

QWidget#documentsView QPushButton#documentToolbarButton:hover {
    background: #22313c;
    border-color: #2ca66a;
}

QPushButton#documentAdvancedFilters {
    background: #17212a;
    color: #dbe4ee;
    border: 1px solid #2d3a45;
    min-height: 30px;
    padding: 3px 10px;
}

QPushButton#documentAdvancedFilters:checked,
QPushButton#documentAdvancedFilters:hover {
    background: #193c2c;
    border-color: #2ca66a;
}

QFrame#foldersPanel {
    background: #111a22;
    border: 1px solid #27343f;
    border-radius: 8px;
}

QSplitter#documentBrowserSplitter::handle {
    background: #263541;
    width: 1px;
}

QFrame#foldersPanel QTreeWidget {
    background: #111a22;
    color: #dbe4ee;
    border: none;
}

QFrame#foldersPanel QTreeWidget::item:selected {
    background: #14532d;
    color: #ffffff;
}

QFrame#storageSidebarPanel {
    background: #0f1820;
    border: none;
    border-top: 1px solid #2b3944;
    border-radius: 0;
}

QLabel#storageSidebarTitle {
    color: #e5edf5;
    font-size: 12px;
    font-weight: 700;
}

QLabel#storageSidebarCaption {
    color: #cbd5e1;
    font-size: 11px;
    font-weight: 650;
}

QLabel#storageUsageLabel,
QLabel#cloudStorageQuotaLabel {
    color: #9fb0c0;
    font-size: 10px;
}

QProgressBar#storageUsageProgress,
QProgressBar#cloudStorageQuotaProgress {
    min-height: 7px;
    max-height: 7px;
    border: none;
    border-radius: 3px;
    background: #263541;
    color: transparent;
}

QProgressBar#storageUsageProgress::chunk,
QProgressBar#cloudStorageQuotaProgress::chunk {
    border-radius: 3px;
    background: #2ca66a;
}

QPushButton#manageStorageButton {
    min-height: 26px;
    text-align: left;
}

QFrame#foldersPanel QPushButton#documentNavigationButton {
    background: transparent;
    color: #cbd5e1;
    border: none;
    text-align: left;
    padding: 4px 8px;
}

QFrame#foldersPanel QPushButton#documentNavigationButton:checked {
    background: #14532d;
    color: #ffffff;
}

QWidget#documentsView QTableWidget {
    background: #111a22;
    alternate-background-color: #15212a;
    color: #e5e7eb;
    border-color: #27343f;
    gridline-color: #27343f;
    selection-background-color: #14532d;
    outline: 0;
}

QWidget#documentsView QTableWidget::item {
    min-height: 34px;
    padding: 5px 7px;
}

QWidget#documentsView QHeaderView::section {
    background: #17212a;
    color: #cbd5e1;
    border-color: #27343f;
}

QWidget#documentsView QTableCornerButton::section {
    background: #17212a;
    border: 1px solid #27343f;
}

QWidget#documentsView QTableWidget::item:selected {
    background: #14532d;
    color: #ffffff;
}

QLabel#documentSelectionStatus {
    color: #94a3b8;
}

QLabel#documentSyncStatus {
    color: #6ee7a6;
}

QWidget#documentsView QFrame#documentDetailsPanel {
    background: #111a22;
    border-color: #27343f;
}

QWidget#documentsView QFrame#documentDetailsPanel QLabel {
    color: #dbe4ee;
}

QWidget#documentsView QScrollArea#documentDetailsScroll,
QWidget#documentsView QWidget#documentDetailsContent,
QWidget#documentsView QScrollArea#documentDetailsScroll QWidget#qt_scrollarea_viewport {
    background: #111a22;
    border: none;
}

QWidget#documentsView QFrame#documentDetailsPanel QPushButton {
    background: #17212a;
    color: #e5e7eb;
    border-color: #2d3a45;
}

QWidget#documentsView QFrame#documentDetailsPanel QPushButton#primary {
    background: #2563eb;
    color: #ffffff;
}

QWidget#documentsView QFrame#documentDetailsPanel QPushButton:disabled {
    background: #151e26;
    color: #64748b;
}

QScrollArea#documentsScrollArea QScrollBar:vertical {
    background: #e2e8f0;
    width: 11px;
    margin: 2px;
    border-radius: 5px;
}

QScrollArea#documentsScrollArea QScrollBar::handle:vertical {
    background: #94a3b8;
    min-height: 32px;
    border-radius: 4px;
}

QScrollArea#documentsScrollArea QScrollBar::handle:vertical:hover {
    background: #64748b;
}

QScrollArea#documentsScrollArea QScrollBar::add-line:vertical,
QScrollArea#documentsScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

QLabel#title {
    font-size: 20px;
    font-weight: 700;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #e6e9ef;
    border-radius: 8px;
    padding: 8px 14px;
    color: #1f2937;
}

QPushButton#primary {
    background: #2563eb;
    color: white;
    border: none;
}

QPushButton#secondary {
    background: #f8fafc;
    color: #334155;
}

QPushButton:disabled {
    color: #94a3b8;
    background: #f8fafc;
}

QTableWidget {
    background: white;
    border: 1px solid #e6e9ef;
    border-radius: 12px;
    gridline-color: #f0f0f5;
}

QHeaderView::section {
    background: transparent;
    padding: 10px;
    color: #64748b;
    font-weight: 600;
}

QFrame#detailPanel,
QFrame#documentDetailsPanel {
    background: white;
    border-left: 1px solid #e6e9ef;
    border-radius: 0px 12px 12px 0px;
}

QLabel#documentDetailsTitle {
    color: #0f172a;
    font-size: 17px;
    font-weight: 700;
}

QLabel#documentDetailsSubtitle,
QLabel#documentCount {
    color: #64748b;
}

QLabel#documentDetailValue {
    color: #334155;
}

QPushButton#dangerAction {
    color: #dc2626;
    background: #ffffff;
    border-color: #fecaca;
}

QLineEdit, QComboBox {
    background: white;
    border: 1px solid #e6e9ef;
    border-radius: 10px;
    padding: 8px;
}

QLineEdit {
    min-height: 36px;
}

QComboBox {
    min-height: 36px;
}

QTextEdit {
    border: 1px solid #e6e9ef;
    border-radius: 10px;
    padding: 12px;
    background: #ffffff;
}

QLabel {
    color: #0f1720;
}

QLabel#scanSubtitle,
QLabel#scanHint {
    color: #64748b;
}

QLabel#scanSectionTitle {
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
}

QFrame#scanToolbar,
QFrame#scanPanel {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QFrame#scanSeparator {
    color: #e2e8f0;
    background: #e2e8f0;
    max-height: 1px;
}

QWidget#scanPreview QScrollArea {
    background: #e5e7eb;
    border: 1px solid #d1d5db;
    border-radius: 6px;
}

QListWidget {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QListWidget::item:selected {
    background: #dcfce7;
    border: 1px solid #22c55e;
    color: #166534;
}

QWidget#pdfViewer {
    background: #171c22;
    color: #e5e7eb;
}

QWidget#pdfViewerToolbar,
QWidget#pdfViewerStatus {
    background: #11161c;
    border-bottom: 1px solid #303841;
}

QWidget#pdfViewerToolbar QPushButton {
    background: transparent;
    color: #e5e7eb;
    border: 1px solid transparent;
    padding: 5px 7px;
    min-width: 0px;
}

QWidget#pdfViewerToolbar QPushButton:hover {
    background: #29313a;
    border-color: #3b4652;
}

QWidget#pdfViewerToolbar QLineEdit,
QWidget#pdfViewerToolbar QComboBox {
    background: #20262d;
    color: #f8fafc;
    border: 1px solid #3b4652;
    border-radius: 6px;
    min-height: 0px;
    max-height: 34px;
    padding: 2px 6px;
}

QWidget#pdfViewerToolbar QLabel,
QWidget#pdfViewerStatus QLabel {
    color: #d1d5db;
}

QWidget#pdfViewerPreview QScrollArea {
    background: #252b31;
    border: none;
}

QWidget#pdfThumbnailPanel,
QTabWidget#pdfViewerTabs {
    background: #161b21;
    color: #e5e7eb;
}

QTabWidget#pdfViewerTabs::pane {
    background: #161b21;
    border: 1px solid #303841;
}

QTabWidget#pdfViewerTabs QTabBar::tab {
    background: #20262d;
    color: #cbd5e1;
    padding: 8px 12px;
    border: 1px solid #303841;
}

QTabWidget#pdfViewerTabs QTabBar::tab:selected {
    background: #161b21;
    color: #ffffff;
    border-bottom-color: #3b82f6;
}

QWidget#pdfInfoPanel,
QScrollArea#pdfInfoScroll,
QWidget#pdfInfoContent,
QScrollArea#pdfInfoScroll QWidget#qt_scrollarea_viewport {
    background: #161b21;
    border: none;
}

QWidget#pdfInfoPanel QLabel,
QWidget#pdfInfoContent QLabel {
    color: #d1d5db;
}

QLabel#pdfViewerPanelTitle {
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
}

QWidget#pdfThumbnailPanel QListWidget {
    background: #161b21;
    color: #e5e7eb;
    border: none;
}

QWidget#pdfThumbnailPanel QListWidget::item:selected {
    background: #173b63;
    border: 1px solid #3b82f6;
    color: #ffffff;
}

QTabWidget#pdfViewerTabs QLabel {
    color: #d1d5db;
}

/* PDF Tools */
QWidget#pdfTools {
    background: #171c22;
    color: #e5e7eb;
}

QWidget#pdfTools QLabel {
    color: #e5e7eb;
}

QWidget#pdfToolsToolbar,
QWidget#pdfToolsStatus {
    background: #11161c;
    border-bottom: 1px solid #303841;
}

QPushButton#pdfToolsToolbarButton {
    background: transparent;
    color: #e5e7eb;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 8px 10px;
    min-height: 34px;
}

QPushButton#pdfToolsToolbarButton:hover,
QPushButton#pdfToolsToolbarButton:checked {
    background: #20354a;
    border-color: #2563eb;
    color: #7dd3fc;
}

QFrame#pdfToolsPanel,
QFrame#pdfToolsActions {
    background: #161b21;
    border: 1px solid #303841;
}

QFrame#pdfToolsPreviewPanel {
    background: #20262d;
    border: 1px solid #303841;
}

QWidget#pdfTools QListWidget {
    background: #161b21;
    color: #e5e7eb;
    border: none;
}

QWidget#pdfTools QListWidget::item {
    background: #1c232a;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px;
}

QWidget#pdfTools QListWidget::item:selected {
    background: #173b63;
    border: 1px solid #3b82f6;
    color: #ffffff;
}

QWidget#pdfToolsPreview QScrollArea {
    background: #2b3138;
    border: none;
}

QPushButton#pdfToolsActionButton {
    background: #1c232a;
    color: #e5e7eb;
    border: none;
    border-bottom: 1px solid #303841;
    border-radius: 3px;
    text-align: left;
    padding: 8px 10px;
    min-height: 45px;
}

QPushButton#pdfToolsActionButton:hover {
    background: #26313a;
}

QLabel#pdfToolsSectionTitle {
    font-weight: 700;
    color: #f8fafc;
    padding: 7px 0px;
}

QPushButton#pdfToolsSave {
    background: #2563eb;
    color: #ffffff;
    border: none;
    min-height: 38px;
    font-weight: 600;
}

/* Autenticação local */
QWidget#authWindow { background: #f5f7fa; }
QWidget#authBrandPanel { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #071827,stop:0.7 #0b2930,stop:1 #075b36); }
QWidget#authBrandPanel QLabel { color: #ffffff; }
QLabel#authBrandLogo { font-size: 34px; font-weight: 800; color: #34c56b; }
QLabel#authBrandSubtitle { font-size: 19px; color: #d7e2ea; padding-top: 18px; }
QLabel#authFeature { font-size: 14px; color: #dce7ed; padding: 10px 0px; }
QWidget#authFormBackground { background: #f5f7fa; }
QWidget#authCard { background: #ffffff; border: 1px solid #dde3ea; border-radius: 14px; }
QWidget#authCard QLabel { color: #172033; }
QLabel#authTitle { font-size: 27px; font-weight: 800; color: #111827; }
QLabel#authCaption { font-size: 16px; color: #64748b; }
QWidget#authCard QLineEdit { background: #ffffff; color: #111827; border: 1px solid #cbd5e1; border-radius: 7px; min-height: 42px; padding: 5px 12px; }
QWidget#authCard QLineEdit:focus { border: 2px solid #22a653; }
QPushButton#authPrimary { background: #1f9d4d; color: #ffffff; border: none; min-height: 44px; font-size: 16px; font-weight: 700; }
QPushButton#authPrimary:hover { background: #16833e; }
QPushButton#authLinkButton { background: transparent; border: none; color: #2563eb; padding: 4px 2px; font-weight: 600; }
QPushButton#authLinkButton:hover { color: #1d4ed8; text-decoration: underline; }
QLabel#authError { color: #dc2626; font-weight: 600; }
QLabel#authHint { background: #eaf8ef; color: #16763a; border-radius: 7px; padding: 9px; }
QRadioButton#templateCard { background: #ffffff; color: #1f2937; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; spacing: 8px; }
QRadioButton#templateCard:checked { background: #eefbf2; border: 2px solid #22a653; color: #14532d; }

/* Cadastro em quatro etapas */
QWidget#registrationContent { background: #fbfcfd; }
QLabel#registrationTitle { color: #101c2c; font-size: 30px; font-weight: 800; }
QLabel#registrationStepCaption { color: #283548; font-size: 16px; }
QPushButton#registrationBackLink { background: transparent; border: none; color: #159342; font-size: 15px; font-weight: 600; padding: 6px 4px; }
QPushButton#registrationBackLink:hover { color: #0d7131; text-decoration: underline; }
QScrollArea#registrationScroll, QStackedWidget#registrationStack, QWidget#registrationPage { background: transparent; border: none; }
QWidget#registrationPage QLabel { color: #172033; }
QLabel#registrationFieldLabel { color: #172033; font-size: 14px; font-weight: 600; }
QLabel#registrationSectionTitle { color: #101c2c; font-size: 22px; font-weight: 750; }
QLabel#registrationHint { color: #667387; font-size: 13px; }
QLabel#registrationValidation { color: #667387; font-size: 12px; }
QLabel#registrationValidation[valid="true"] { color: #13883d; font-weight: 600; }
QWidget#registrationPage QLineEdit,
QWidget#registrationPage QComboBox,
QWidget#registrationPage QTextEdit { background: #ffffff; color: #172033; border: 1px solid #cdd5df; border-radius: 9px; padding: 7px 12px; selection-background-color: #b9ebc9; }
QWidget#registrationPage QLineEdit:focus,
QWidget#registrationPage QComboBox:focus,
QWidget#registrationPage QTextEdit:focus { border: 2px solid #159b46; }
QLabel#passwordRequirements { color: #415066; font-size: 12px; padding-top: 6px; }
QLabel#passwordStrengthLabel { color: #167e3b; font-weight: 700; padding-left: 8px; }
QFrame#avatarPanel { background: transparent; min-width: 230px; }
QLabel#avatarPreview { background: #edf9f1; color: #159b46; border: 2px solid #169b45; border-radius: 85px; font-size: 38px; font-weight: 800; }
QPushButton#avatarChooseButton { background: #ffffff; color: #138b3f; border: 1px solid #cdd5df; min-height: 42px; font-weight: 600; }
QPushButton#avatarRemoveButton { background: #ffffff; color: #dc2626; border: 1px solid #cdd5df; min-height: 42px; font-weight: 600; }
QRadioButton#templateCard { font-size: 14px; line-height: 1.4; padding: 16px; }
QLabel#registrationSummary { background: #ffffff; color: #263448; border: 1px solid #dbe2ea; border-radius: 12px; padding: 22px; font-size: 15px; }
QLabel#registrationCompletion { background: #eaf8ef; color: #126f34; border: 1px solid #9edbb2; border-radius: 12px; padding: 28px; font-size: 17px; }
QFrame#registrationActions { background: #ffffff; border-top: 1px solid #dfe5ec; }
QPushButton#registrationSecondary { background: #ffffff; color: #263448; border: 1px solid #cdd5df; min-height: 42px; padding: 0 20px; font-weight: 600; }
QFrame#registrationActions QPushButton#authPrimary { min-width: 170px; padding: 0 22px; }
QFrame#registrationFooter { background: #f0f8f3; border-top: 1px solid #d6e7dc; color: #4a586b; }
QFrame#registrationFooter QLabel { color: #4a586b; }
QLabel#registrationSecureText { color: #187c3c; }
QToolButton#accountButton { background: #17212a; color: #e5e7eb; border: 1px solid #334155; border-radius: 6px; padding: 5px 10px; }

/* Solicitações e Entregas */
QWidget#deliveryWorkspace { background: #f5f7fa; color: #172033; }
QWidget#deliveryWorkspace QLabel { color: #334155; }
QLabel#deliveryTitle { color: #101c2c; font-size: 24px; font-weight: 800; }
QWidget#deliveryWorkspace QTabWidget::pane { background: #ffffff; border: 1px solid #d8e0e8; }
QWidget#deliveryWorkspace QTabBar::tab { background: #edf1f5; color: #334155; padding: 9px 12px; }
QWidget#deliveryWorkspace QTabBar::tab:selected { background: #ffffff; color: #1769e8; border-bottom: 2px solid #1769e8; }
QWidget#deliveryWorkspace QListWidget { background: #ffffff; color: #172033; border: 1px solid #d8e0e8; }
QWidget#deliveryWorkspace QLineEdit, QWidget#deliveryWorkspace QTextEdit, QWidget#deliveryWorkspace QComboBox { background: #ffffff; color: #172033; border: 1px solid #cbd5e1; border-radius: 5px; padding: 5px; }
QPushButton#deliveryPrimary { background: #1f9d4d; color: white; border: none; min-height: 40px; font-weight: 700; }

/* Explorador lógico da cesta */
QDialog#deliveryDocumentPicker, QDialog#deliveryNetworkDialog { background: #f7f9fb; color: #172033; }
QDialog#deliveryDocumentPicker QLabel, QDialog#deliveryNetworkDialog QLabel { color: #334155; }
QDialog#deliveryDocumentPicker QLabel#dialogTitle,
QDialog#deliveryNetworkDialog QLabel#dialogTitle { color: #101c2c; font-size: 24px; font-weight: 800; }
QDialog#deliveryDocumentPicker QLabel#pickerBreadcrumb { color: #145f35; font-size: 15px; font-weight: 650; padding: 6px; }
QDialog#deliveryDocumentPicker QLabel#pickerFolderTitle,
QDialog#deliveryNetworkDialog QLabel#sectionTitle { color: #101c2c; font-size: 18px; font-weight: 750; }
QDialog#deliveryDocumentPicker QTreeWidget,
QDialog#deliveryDocumentPicker QTableWidget { background: #ffffff; color: #172033; border: 1px solid #d8e0e8; border-radius: 7px; gridline-color: #e3e8ee; }
QDialog#deliveryDocumentPicker QTreeWidget::item { min-height: 30px; padding: 2px 5px; }
QDialog#deliveryDocumentPicker QTreeWidget::item:selected,
QDialog#deliveryDocumentPicker QTableWidget::item:selected { background: #dff4e6; color: #11652f; }
QDialog#deliveryDocumentPicker QHeaderView::section { background: #f4f7f9; color: #334155; border: none; border-bottom: 1px solid #d8e0e8; padding: 8px; font-weight: 700; }
QDialog#deliveryDocumentPicker QLineEdit,
QDialog#deliveryNetworkDialog QLineEdit,
QDialog#deliveryNetworkDialog QComboBox,
QDialog#deliveryNetworkDialog QSpinBox { background: #ffffff; color: #172033; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px; }
QLabel#pickerEmptyState { color: #64748b; padding: 24px; }

/* Descoberta e autorização de instalações LAN */
QDialog#deliveryNetworkDialog QScrollArea,
QDialog#deliveryNetworkDialog QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QDialog#deliveryNetworkDialog QWidget#networkDialogBody { background: transparent; }
QDialog#deliveryNetworkDialog QFrame#networkDeviceCard { background: #ffffff; border: 1px solid #d8e0e8; border-radius: 10px; }
QDialog#deliveryNetworkDialog QFrame#networkDeviceCard[cardRole="local"] { border-color: #bdd4c6; background: #fbfefc; }
QDialog#deliveryNetworkDialog QFrame#networkDeviceCard[cardRole="empty"] { background: #f8fafc; border-style: dashed; }
QDialog#deliveryNetworkDialog QPushButton { min-height: 30px; padding: 4px 12px; border-radius: 6px; }
QDialog#deliveryNetworkDialog QPushButton:hover { background: #edf6f0; border-color: #7dbb91; color: #11652f; }
QDialog#deliveryNetworkDialog QPushButton:disabled { color: #94a3b8; background: #f1f5f9; border-color: #d8e0e8; }
QLabel#deviceName { color: #101c2c; font-size: 16px; font-weight: 750; }
QLabel#secondaryText { color: #64748b; }
QLabel#statusOnline { background: #dff4e6; color: #117338; border-radius: 10px; padding: 3px 9px; font-weight: 650; }
QLabel#statusFound { background: #e7efff; color: #2454b8; border-radius: 10px; padding: 3px 9px; font-weight: 650; }
QLabel#statusNeutral { background: #eef1f4; color: #526172; border-radius: 10px; padding: 3px 9px; font-weight: 650; }
QLabel#statusError { background: #fee8e8; color: #b42318; border-radius: 10px; padding: 3px 9px; font-weight: 650; }
QLabel#networkInfoState, QLabel#networkSuccessState, QLabel#networkErrorState { border-radius: 6px; padding: 9px 12px; }
QLabel#networkInfoState { background: #eaf2ff; color: #2454b8; border: 1px solid #bfd2f7; }
QLabel#networkSuccessState { background: #e6f6eb; color: #117338; border: 1px solid #addcba; }
QLabel#networkErrorState { background: #fff0f0; color: #b42318; border: 1px solid #f1b8b8; }
QDialog#deliveryNetworkDialog QGroupBox { background: #ffffff; color: #334155; border: 1px solid #d8e0e8; border-radius: 8px; margin-top: 12px; padding: 12px 10px 10px 10px; font-weight: 650; }
QDialog#deliveryNetworkDialog QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; }
QDialog#deliveryNetworkDialog QLineEdit:focus,
QDialog#deliveryNetworkDialog QComboBox:focus,
QDialog#deliveryNetworkDialog QSpinBox:focus { border: 1px solid #279153; }
QScrollArea#networkDialogScroll QScrollBar:vertical { background: #eef2f5; width: 10px; margin: 0; border: none; }
QScrollArea#networkDialogScroll QScrollBar::handle:vertical { background: #b9c4cf; border-radius: 5px; min-height: 30px; }
QScrollArea#networkDialogScroll QScrollBar::handle:vertical:hover { background: #8fa0b0; }
QScrollArea#networkDialogScroll QScrollBar::add-line:vertical,
QScrollArea#networkDialogScroll QScrollBar::sub-line:vertical { height: 0; }

/* Contexto de entregas e aquisição de assinatura visual */
QFrame#pdfViewerContextBar {
    background: #f0f8f3;
    border-bottom: 1px solid #b9dcc5;
}
QLabel#pdfViewerContextTitle { color: #123d24; font-size: 14px; font-weight: 750; }
QDialog#deliveryAcknowledgementDialog { background: #f7f9fb; }
QDialog#deliveryAcknowledgementDialog QLabel#acknowledgementDeclaration {
    background: #eef6f1; color: #214b31; border: 1px solid #c8dfd0;
    border-radius: 8px; padding: 10px;
}
QLabel#signatureImagePreview {
    background: #ffffff; border: 1px dashed #aab7c4; border-radius: 8px;
    color: #64748b; padding: 10px;
}

/* Captura e PDF */
QWidget#capturePdf { background: #171c22; color: #e5e7eb; }
QWidget#capturePdf QLabel { color: #e5e7eb; }
QFrame#capturePdfHeader, QFrame#capturePdfFooter { background: #11161c; border-bottom: 1px solid #303841; }
QFrame#capturePdfFooter { border-top: 1px solid #303841; border-bottom: none; }
QLabel#capturePdfTitle { color: #ffffff; font-size: 21px; font-weight: 750; }
QLabel#capturePdfSubtitle, QLabel#capturePdfOrigin { color: #cbd5e1; }
QToolButton#capturePdfToolbarButton { background: transparent; color: #e5e7eb; border: 1px solid transparent; border-radius: 6px; padding: 6px 14px; min-width: 68px; }
QToolButton#capturePdfToolbarButton:hover { background: #20354a; border-color: #2563eb; color: #7dd3fc; }
QScrollArea#capturePdfScanScroll, QScrollArea#capturePdfScanScroll QWidget#qt_scrollarea_viewport, QFrame#capturePdfPanel { background: #1b2128; border: none; }
QFrame#capturePdfPanel { border-right: 1px solid #303841; }
QFrame#capturePdfPreviewPanel { background: #20262d; border: none; }
QLabel#capturePdfSection { color: #f8fafc; font-weight: 750; font-size: 13px; padding: 4px 0; }
QLabel#capturePdfHint { background: #dbeafe; color: #1e3a5f; border-radius: 5px; padding: 10px; }
QWidget#capturePdf QComboBox { background: #2a3139; color: #e5e7eb; border: 1px solid #46515d; border-radius: 4px; min-height: 30px; padding: 2px 8px; }
QWidget#capturePdf QCheckBox { color: #e5e7eb; spacing: 7px; }
QPushButton#capturePdfPrimary { background: #2563eb; color: #ffffff; border: none; min-height: 42px; font-weight: 650; }
QPushButton#capturePdfWideButton { background: #252c34; color: #e5e7eb; border: 1px solid #46515d; min-height: 36px; text-align: left; padding-left: 12px; }
QPushButton#capturePdfAction { background: transparent; color: #e5e7eb; border: 1px solid transparent; min-height: 34px; padding: 5px 8px; }
QPushButton#capturePdfAction:hover { background: #27323d; border-color: #46515d; }
QListWidget#capturePdfPages { background: #171c22; color: #e5e7eb; border: none; }
QListWidget#capturePdfPages::item { background: #20262d; border: 1px solid transparent; border-radius: 5px; padding: 4px; }
QListWidget#capturePdfPages::item:selected { background: #173b63; border: 2px solid #3b82f6; color: #ffffff; }
QWidget#capturePdfPreview QScrollArea { background: #2b3138; border: none; }
QLabel#capturePdfPageIndicator { background: #151a20; border: 1px solid #46515d; border-radius: 4px; padding: 6px 14px; }
QPushButton#capturePdfGed { background: #249447; color: #ffffff; border: none; min-height: 38px; font-weight: 700; padding: 0 18px; }
